# Runtime outputs
runs/
logs/
results/
wandb/
.venv/

# Python/cache
__pycache__/
.pytest_cache/
*.py[cod]

# Large generated artifacts by default
*.jsonl
*.log
*.pt
*.pth
*.pkl
*.gif
artifacts/**/_workers/
artifacts/**/episode_*.json
artifacts/**/summary_*_seed_*.json

# Immutable upstream snapshots intentionally retain their supplied weights.
!vendor/upstream/**/*.pt
!vendor/upstream/**/*.pth
!vendor/upstream/**/*.pkl
artifacts/open_encirclement_ctde/**/state.lock
artifacts/open_encirclement_ctde/l0/
artifacts/open_encirclement_ctde/l0_supervisor/

# Keep curated A3 best artifacts in this staging copy.
!artifacts/2026-07-23_a3_apfnew_sqrtn_curriculum/best_20rollout10gif/stage*/step_*.pt
!artifacts/2026-07-23_a3_apfnew_sqrtn_curriculum/best_20rollout10gif/stage*/mix/rollout_mix_seed_*.gif
# Final integrated release keeps exactly three selected checkpoints. Rollouts
# and GIFs remain ignored.
!artifacts/2026-08-04_crms_vctls_ce_final/checkpoints/*.pt
artifacts/validation_rollouts_*/
